# Production settings for docker-compose.yml. Copy to deploy/production.env (git-ignored)
# and edit it. For a local test of the whole stack, keep LEADFLOW_DOMAIN=localhost and
# accept the browser warning about Caddy's local certificate.

# The public domain name, pointing (DNS A record) at this server. Caddy gets HTTPS for it.
LEADFLOW_DOMAIN=leadflow.example.com

# Optional service key for scripts; empty = login only (recommended on a server).
LEADFLOW_OPERATOR_TOKEN=

# The public no-password demo (private, disposable sandboxes with fictional data).
LEADFLOW_DEMO_ENABLED=true
LEADFLOW_DEMO_MAX_SANDBOXES=30
LEADFLOW_DEMO_LIFETIME_MINUTES=120

# AI-assisted drafts stay off on a server (no local model there).
