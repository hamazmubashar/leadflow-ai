# Copy to .env (git-ignored).
#
# Optional service key for scripts (scripts/seed_demo.py) and, for now, the dashboard.
# It has admin rights and its changes are recorded as "system". Empty = login only:
# people sign in with accounts created by `uv run python -m leadflow_ai.manage_users`.
# Generate one (at least 32 characters, no spaces) with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LEADFLOW_OPERATOR_TOKEN=

# Optional. Local SQLite file; only sqlite:/// URLs are accepted.
# LEADFLOW_DATABASE_URL=sqlite:///./leadflow.db

# Where the dashboard and scripts/seed_demo.py find the API. scripts/dev.sh starts
# the API on port 8001 (and passes its own URL to the dashboard). Plain http:// is
# accepted for localhost only.
LEADFLOW_API_URL=http://127.0.0.1:8001

# Optional (M9): AI-assisted drafts with a local Ollama model. Off while
# LEADFLOW_LLM_URL is unset. Only http:// on localhost, 127.0.0.1 or ::1 is
# accepted; any other address stops the API at startup.
# LEADFLOW_LLM_URL=http://127.0.0.1:11434
# LEADFLOW_LLM_MODEL=qwen2.5:3b
# LEADFLOW_LLM_TIMEOUT_SECONDS=120

# Optional (M12): the public no-password demo. Each visitor gets a private, disposable
# copy of the fictional Harborline data; it never touches the main database. Off by default.
# LEADFLOW_DEMO_ENABLED=true
# LEADFLOW_DEMO_DIR=./demo-sandboxes
# LEADFLOW_DEMO_MAX_SANDBOXES=30
# LEADFLOW_DEMO_LIFETIME_MINUTES=120
