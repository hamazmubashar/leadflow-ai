# Copy to .env (git-ignored) and set a value.
# Generate a token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be at least 32 characters. Left empty on purpose so the app refuses
# to start until a real token is set.
LEADFLOW_OPERATOR_TOKEN=

# Optional. Local SQLite file; only sqlite:/// URLs are accepted.
# LEADFLOW_DATABASE_URL=sqlite:///./leadflow.db

# Optional, used by the Streamlit dashboard. Plain http:// is accepted for localhost only.
# LEADFLOW_API_URL=http://127.0.0.1:8000

# Optional (M9): AI-assisted drafts with a local Ollama model. Off while
# LEADFLOW_LLM_URL is unset. Only http:// on localhost, 127.0.0.1 or ::1 is
# accepted; any other address stops the API at startup.
# LEADFLOW_LLM_URL=http://127.0.0.1:11434
# LEADFLOW_LLM_MODEL=qwen2.5:3b
# LEADFLOW_LLM_TIMEOUT_SECONDS=120
